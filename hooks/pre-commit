#!/usr/bin/env bash
# Block commits containing secrets (gitleaks). Disable: git config hooks.gitleaks.enable false

if [ "$(git config --get hooks.gitleaks.enable)" = "false" ]; then
    exit 0
fi

root="$(git rev-parse --show-toplevel)"

if ! command -v gitleaks >/dev/null 2>&1; then
    if [ "$(git config --get hooks.gitleaks.autoinstall)" = "false" ]; then
        echo "gitleaks not installed and autoinstall is off." >&2
        exit 1
    fi
    echo "gitleaks not found, installing..."
    sh "$root/scripts/install-gitleaks.sh" || exit 1
    export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
fi

config=""
[ -f "$root/.gitleaks.toml" ] && config="--config=$root/.gitleaks.toml"

if ! gitleaks protect --staged --redact $config; then
    echo "Commit blocked: secrets detected. Remove them or bypass with 'git commit --no-verify'." >&2
    exit 1
fi
